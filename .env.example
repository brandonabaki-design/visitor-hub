# ─────────────────────────────────────────────────────────────────────────────
# Visitor Hub configuration
# Copy this file to `.env` and adjust. All values have sensible defaults so the
# app runs out of the box for local/kiosk use without any configuration.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=3000
HOST=0.0.0.0

# School / branding (shown on the kiosk and in emailed receipts)
SCHOOL_NAME=Greenfield International School
SCHOOL_LOGO_URL=
SUPPORT_EMAIL=reception@example.com

# Where the SQLite database file lives
DATABASE_PATH=./data/visitor-hub.db

# Secret used to sign admin session cookies (JWT). CHANGE THIS in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account, created on first run if no admins exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Reception Admin

# ── Email (visitor receipts) ─────────────────────────────────────────────────
# Transport: "smtp" to send real email, or "preview" (default) to write each
# message to ./sent-emails/*.html instead of sending — perfect for development.
EMAIL_TRANSPORT=preview
EMAIL_FROM="Visitor Hub <no-reply@example.com>"

# Only used when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Data retention: visits older than this many days can be purged via the admin
# "Purge old records" action (PDPL data-minimisation). 0 disables purging.
RETENTION_DAYS=365
